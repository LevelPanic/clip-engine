{
  "name": "clip-engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "YouTube link → ranked clip candidates → marker-based 9:16 editor → MP4",
  "scripts": {
    "clip": "tsx src/cli/index.ts",
    "studio": "tsx src/cli/index.ts studio",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test --test-reporter=spec test/*.test.ts",
    "test:e2e": "E2E=1 tsx --test --test-reporter=spec --test-concurrency=1 test/e2e/*.test.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/captions": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/install-whisper-cpp": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@vitejs/plugin-react": "6.2.1",
    "commander": "15.0.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "tsx": "4.23.15",
    "vite": "8.3.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
